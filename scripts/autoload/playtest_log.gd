class_name PlaytestLog
extends RefCounted
## Opt-in, local-only observations. Never stored in a game save or sent to a server.
const PATH = "user://playtests/observations.json"
static var cache: Dictionary = {}
static var loaded := false
static var boot_id := str(Time.get_unix_time_from_system()) + "_" + str(Time.get_ticks_usec())
static var pending_seconds := 0.0

static func data() -> Dictionary:
	if not loaded:
		loaded = true
		if FileAccess.file_exists(PATH):
			var parsed = JSON.parse_string(FileAccess.get_file_as_string(PATH))
			if parsed is Dictionary: cache = parsed
		if not cache.has("runs"): cache = {"version":1, "runs":{}}
	return cache

static func save() -> void:
	DirAccess.make_dir_recursive_absolute("user://playtests")
	var file = FileAccess.open(PATH, FileAccess.WRITE)
	if file: file.store_string(JSON.stringify(data(), "\t"))

static func create_run() -> String:
	var id = "playtest_" + str(Time.get_unix_time_from_system()).replace(".", "_") + "_" + str(randi_range(1000,9999))
	data()["runs"][id] = {"sessions":0, "foreground_seconds":0.0, "jobs":{}, "completed":false, "return_visits":0, "later_launch_return":false, "survey":{}, "ending_choice":"unobserved"}
	save()
	return id

static func current() -> Dictionary:
	return data()["runs"].get(Game.save_slot, {})

static func start_session() -> void:
	var r = current()
	if r.is_empty(): return
	if r["completed"]:
		r["return_visits"] += 1
		if r.get("completion_boot", "") != boot_id: r["later_launch_return"] = true
	r["sessions"] += 1
	save()

static func tick(delta: float) -> void:
	if not Game.running or not Game.get_window().has_focus(): return
	var r = current()
	if r.is_empty(): return
	r["foreground_seconds"] += clampf(delta, 0, 1)
	pending_seconds += delta
	if pending_seconds >= 15: pending_seconds = 0; save()

static func job_row(job: Dictionary) -> Dictionary:
	var r = current()
	if r.is_empty() or not job.has("demo_index"): return {}
	var key = str(job["demo_index"])
	if not r["jobs"].has(key):
		r["jobs"][key] = {"mode":job.get("play_mode", "manual"), "edits":0, "edits_after_review":0, "reviews":0, "listens":0, "versions_heard":[], "comparisons":0, "accepted":false, "released":false}
	return r["jobs"][key]

static func accepted(job: Dictionary) -> void:
	var row = job_row(job)
	if row.is_empty(): return
	row["accepted"] = true
	row["mode"] = job.get("play_mode", "manual")
	save()

static func event(kind: String, meeting: Dictionary) -> void:
	if meeting.is_empty(): return
	var row = job_row(Game.get_job(meeting.get("job_id", "")))
	if row.is_empty(): return
	match kind:
		"edit":
			row["edits"] += 1
			if row["reviews"] > 0: row["edits_after_review"] += 1
		"review": row["reviews"] += 1
		"compare": row["comparisons"] += 1
		"listen":
			row["listens"] += 1
			var signature = []
			for p in meeting["placed"]:
				var b = meeting["deck"][p["block"]]
				signature.append("%s/%s/%s/%s/%s/%s/%s/%s" % [p["row"],p["col"],b["genre"],b.get("style",0),b.get("transpose",0),b.get("volume",1),meeting["bpm"],JSON.stringify(b.get("signature",{}))])
			signature.sort()
			var digest = JSON.stringify(signature).sha256_text()
			if not digest in row["versions_heard"]: row["versions_heard"].append(digest)
	save()

static func released(job: Dictionary) -> void:
	var row = job_row(job)
	if row.is_empty(): return
	row["released"] = true
	if int(job["demo_index"]) == 2:
		current()["completed"] = true
		current()["completion_boot"] = boot_id
	save()

static func answer(key: String, value: int) -> void:
	if current().is_empty() or key not in ["explore", "next", "return"] or value < 0 or value > 5: return
	current()["survey"][key] = value # 0 = skipped; 1..5 = self-reported rating.
	save()

static func ending(choice: int) -> void:
	if current().is_empty(): return
	current()["ending_choice"] = "continue" if choice == 0 else "title"
	save()

static func erase(id: String) -> void:
	data()["runs"].erase(id)
	save()
	# Remove the export generated by this feature too; the game save remains intact.
	var path = "user://playtests/report-" + id + ".json"
	if FileAccess.file_exists(path): DirAccess.remove_absolute(ProjectSettings.globalize_path(path))

static func export_run(id: String) -> String:
	if not data()["runs"].has(id): return ""
	var path = "user://playtests/report-" + id + ".json"
	var file = FileAccess.open(path, FileAccess.WRITE)
	if not file: return ""
	file.store_string(JSON.stringify(data()["runs"][id], "\t"))
	return ProjectSettings.globalize_path(path)

static func report(id: String) -> String:
	var r: Dictionary = data()["runs"].get(id, {})
	if r.is_empty(): return Locale.text("pt_empty")
	var lines = [Locale.text("pt_summary", [r["sessions"], roundi(float(r["foreground_seconds"]) / 60), r["return_visits"], Locale.text("pt_yes" if r["later_launch_return"] else "pt_unobserved")])]
	for index in 3:
		var j: Dictionary = r["jobs"].get(str(index), {})
		if j.is_empty():
			lines.append(Locale.text("pt_job_missing", [index + 1])); continue
		lines.append(Locale.text("pt_job", [index+1,j["mode"],j["edits"],j["versions_heard"].size(),j["edits_after_review"],j["comparisons"],Locale.text("pt_yes" if j["released"] else "pt_unobserved")]))
	lines.append(Locale.text("pt_choice_" + r["ending_choice"]))
	for key in ["explore", "next", "return"]:
		var rating = int(r["survey"].get(key, 0))
		lines.append(Locale.text("pt_question_" + key) + " : " + (str(rating) + "/5" if rating > 0 else Locale.text("pt_unanswered")))
	lines.append(Locale.text("pt_caution"))
	return "\n\n".join(lines)
