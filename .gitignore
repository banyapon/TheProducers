# The Producers — public repo holds only the Godot project and its Aseprite sources.

# ---- Godot 4 ----
.godot/
.import/
.nomedia
export.cfg
export_credentials.cfg
*.translation
.mono/
data_*/
mono_crash.*.json

# ---- Secrets: never commit ----
config/secrets.cfg
.env
.env.*
*.pem
*.key

# ---- Build output and release media ----
# builds/windows and builds/web are committed; their large files go through Git LFS (.gitattributes).
releases/
*.zip
*.avi

# ---- Aseprite: keep .aseprite sources, Lua scripts and reports ----
aseprite/sources/*
!aseprite/sources/sprites/
!aseprite/sources/media/
aseprite/sources/sprites/*
!aseprite/sources/sprites/*.aseprite
aseprite/sources/media/*
!aseprite/sources/media/*.aseprite
aseprite/**/*.py
*.aseprite-backup

# ---- Not part of the Godot / Aseprite project ----
server/
docs/
config/SETUP.txt
tools/
__pycache__/
*.pyc
.agents/
.claude/
.qa/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---- Markdown: keep only the root README ----
*.[mM][dD]
!/README.md
