size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="JobRow" type="HBoxContainer" parent="Window/VBox/SetupScroll/SetupBox"]
layout_mode = 2

[node name="Label" type="Label" parent="Window/VBox/SetupScroll/SetupBox/JobRow"]
layout_mode = 2
text = "งานที่รับไว้:"

[node name="JobOption" type="OptionButton" parent="Window/VBox/SetupScroll/SetupBox/JobRow"]
unique_name_in_owner = true
