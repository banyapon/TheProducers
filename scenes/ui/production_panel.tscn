[node name="SetupScroll" type="ScrollContainer" parent="Window/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="SetupBox" type="VBoxContainer" parent="Window/VBox/SetupScroll"]
